opam-version: "2.0"
synopsis:
  "A voxel engine in OCaml, rendering with WebGPU (wgpu-native) and SDL2"
description:
  "An experimental voxel engine written in OCaml. Windowing and input come from SDL2 (tsdl); rendering goes through WebGPU via the wgpu-ocaml bindings to wgpu-native."
maintainer: ["Lloyd <hello@lloydgw.com>"]
authors: ["Lloyd <hello@lloydgw.com>"]
license: "GPL-3.0-only"
tags: ["webgpu" "wgpu" "graphics" "voxel"]
homepage: "https://github.com/lloyd-g-w/vox"
doc: "https://github.com/lloyd-g-w/vox"
bug-reports: "https://github.com/lloyd-g-w/vox/issues"
depends: [
  "ocaml" {>= "5.2.0"}
  "dune" {>= "3.23"}
  "tsdl"
  "ctypes"
  "ctypes-foreign"
  "wgpu"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/lloyd-g-w/vox.git"
x-maintenance-intent: ["(latest)"]
# The wgpu bindings are not on the public opam repository, so the exact commit
# this tree builds against is pinned here; `opam install . --deps-only` honours
# it. To move to a newer commit, change the hash, run `dune build` (and
# `dune promote` if it reports an opam-file diff), then re-run
# `opam install . --deps-only`.
pin-depends: [
  [
    "wgpu.dev"
    "git+https://github.com/lloyd-g-w/wgpu-ocaml.git#3777b867245d7546a3655c3863cebd9b1551615a"
  ]
]
